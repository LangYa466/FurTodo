{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "furtodo-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  // node-postgres (pg) needs the Node.js APIs.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "todo.example.com", "custom_domain": true }],

  // Requests run several sequential queries, so the Worker should run near the
  // database rather than near the user.
  "placement": { "mode": "smart" },

  // PostgreSQL through Hyperdrive. Create the config with caching disabled,
  // because sessions, quotas, and sync must read their own writes:
  //   npx wrangler hyperdrive create furtodo-db --caching-disabled --connection-string="$DATABASE_URL"
  // Put the printed id here, and run `npm run db:migrate` with the same
  // DATABASE_URL before deploying.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID" }],

  // The UserHub Durable Object was replaced by PostgreSQL; v2 deletes the class
  // and its storage.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v2", "deleted_classes": ["UserHub"] }
  ],

  // Every minute: send due reminders. Hourly: purge expired data.
  "triggers": { "crons": ["* * * * *", "17 * * * *"] },

  // Per-IP limit on the unauthenticated login endpoints, counted per location.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } }],

  // The integration guide is bundled as text.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],

  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },

  "secrets": {
    "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "TOKEN_SECRET", "VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY"]
  },

  "vars": {
    "PUBLIC_BASE_URL": "https://todo.example.com",
    // Accounts younger than this many days cannot use the API.
    "MIN_ACCOUNT_AGE_DAYS": "365",
    "GITHUB_API_BASE": "https://api.github.com",
    "GITHUB_OAUTH_BASE": "https://github.com",
    // Comma-separated; `*` may stand for a subdomain, port, or path suffix.
    "ALLOWED_REDIRECT_URIS": "http://localhost:*/*,http://127.0.0.1:*/*,furtodo://*,https://*.example.com/*",
    "VAPID_SUBJECT": "mailto:admin@example.com",

    // Per-user daily quotas bound the database work one account can cause;
    // reads and writes count entity rows. They reset at midnight in
    // QUOTA_TIMEZONE.
    "QUOTA_TIMEZONE": "Asia/Shanghai",
    "QUOTA_REQUESTS_PER_DAY": "20000",
    "QUOTA_READS_PER_DAY": "200000",
    "QUOTA_WRITES_PER_DAY": "10000",
    "QUOTA_LOGINS_PER_DAY": "30",
    "QUOTA_PUSH_PER_DAY": "500",

    // Per-user totals.
    "LIMIT_MAX_ENTITIES": "20000"
  }
}
